# Copy to .env and replace every value before starting Compose.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TASK_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
EXPORTER_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
PGADMIN_EMAIL=student@example.com
PGADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Bind published ports to loopback for a local classroom demo.
WEB_BIND_ADDRESS=127.0.0.1
